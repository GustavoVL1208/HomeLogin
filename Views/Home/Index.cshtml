@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/Menu.css" asp-append-version="true">

    <title>Menu</title>
</head>

<body>

    <header class="header">
        <img src="~/img/LogoFundoAzul.jpeg" class="Logo" alt="LogoVizi">

        <nav class="menu">
            <a class="navegacao" asp-controller="Login" asp-action="Sair">Logout</a>

            <a class="navegacao" href="#">Inicio</a>
            <a class="navegacao" href="#">Serviços</a>
            <a href="#" class="notificação">
                <img src="~/img/sino.jpeg" class="Sino" alt="sino">
            </a>
        </nav>
    </header>

    <main class="main">

        <div class="search-section-sticky">
            <form asp-action="Index" method="get" class="search-form">
                <input type="text" name="searchString" placeholder="Buscar serviço, profissionais..." class="search-input" value="@ViewBag.SearchString">
                <input type="hidden" name="tipo" value="@ViewBag.TipoSelecionado" />
                <button type="button" class="btn-filter" title="Filtrar">
                    <img src="https://img.icons8.com/?size=100&id=JtjLMpBJnO8T&format=png&color=000000" alt="Filtro" />
                </button>

                @if (User.Identity.IsAuthenticated && User.IsInRole("Prestador"))
                {
                    <a asp-controller="Servico" asp-action="NovoServico" class="btn-novo-servico">
                        <span>Novo Serviço</span>
                    </a>
                }

            </form>
        </div>

        <div class="filter-buttons-container">
            <a asp-action="Index" asp-route-tipo="Todos" asp-route-searchString="@ViewBag.SearchString"
               class="filter-btn @(ViewBag.TipoSelecionado == "Todos" ? "active" : "")">Todos</a>

            <a asp-action="Index" asp-route-tipo="Presencial" asp-route-searchString="@ViewBag.SearchString"
               class="filter-btn @(ViewBag.TipoSelecionado == "Presencial" ? "active" : "")">Presencial</a>

            <a asp-action="Index" asp-route-tipo="Online" asp-route-searchString="@ViewBag.SearchString"
               class="filter-btn @(ViewBag.TipoSelecionado == "Online" ? "active" : "")">Online</a>
        </div>

@model IEnumerable<Servico>

    <div class="servicos">
        @foreach (var item in Model)
        {
            <div class="card-servico">
                <div class="card-header-image"></div>
                <div class="card-content">
                        <h3 class="Titulo">
                            <a asp-controller="Servico"
                               asp-action="ServicoDetalhado"
                               asp-route-id="@item.Id">
                                @item.NomeServico
                            </a>
                        </h3>
                    <span class="Nome">@item.Profissional</span>
                    <p class="TipoServico">@item.TipoServico</p>

                    <div class="card-footer">
                        <span class="Preco">@item.Preco</span>
                        <span class="Contato">@item.Contato</span>
                    </div>
                </div>
            </div>
        }
    </div>

        <nav class="paginacao-container">
            <ul class="pagination">
                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaAtual ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pagina="@i"
                           asp-route-searchString="@ViewBag.SearchString"
                           asp-route-tipo="@ViewBag.TipoSelecionado">@i</a>
                    </li>
                }
            </ul>
        </nav>

    </main>
    

    <footer class="footer">
        © Vizi 2026 - Todos os direitos reservados.

        <div class="contato">
            <a>contato</a>
            <a>vizi.site@gmail.com</a>
        </div>
    </footer>

</body>
</html>
