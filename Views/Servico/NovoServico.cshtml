@model ViziLogin.Models.Servico

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/NovoServico.css">

    <title>Novo Serviço</title>
</head>

<body>

    <header class="header">

        <img src="~/img/LogoFundoAzul.jpeg"
             class="Logo"
             alt="LogoVizi">

        <nav class="menu">

            <a class="navegacao" asp-controller="Home" asp-action="Index">
                Inicio
            </a>

            <a class="navegacao" href="#">
                Serviços
            </a>

            <a href="#" class="notificacao">
                <img src="~/img/sino.jpeg"
                     class="Sino"
                     alt="sino">
            </a>

        </nav>

    </header>

    <main class="main">

        <div class="card">

            <img src="~/img/Logo.jpeg"
                 class="logo-card"
                 alt="Logo">

            <h2 class="titulo">
                Novo Serviço
            </h2>

            <p class="subtitulo">
                Preencha os dados abaixo
            </p>

            <form asp-controller="Servico"
                  asp-action="Criar"
                  method="post">

                <div class="campo">

                    <label>
                        Nome do Serviço
                    </label>

                    <input asp-for="NomeServico"
                           placeholder="Ex: Encanador Residencial" />

                </div>

                <div class="campo">

                    <label>
                        Tipo de Serviço
                    </label>

                    <div class="tipo-servico">

                        <input type="radio"
                               asp-for="TipoServico"
                               value="Presencial"
                               id="presencial">

                        <label for="presencial"
                               class="opcao">
                            Presencial
                        </label>

                        <input type="radio"
                               asp-for="TipoServico"
                               value="Online"
                               id="online">

                        <label for="online"
                               class="opcao">
                            Online
                        </label>

                    </div>

                </div>

                <div class="campo">

                    <label>
                        Profissional
                    </label>

                    <input asp-for="Profissional"
                           placeholder="Ex: Carlos Santos" />

                </div>

                <div class="campo">

                    <label>
                        Preço
                    </label>

                    <input asp-for="Preco"
                           placeholder="Ex: R$ 80-150" />

                </div>

                <button type="submit"
                        class="btn-criar">

                    Criar Serviço

                </button>

            </form>

        </div>

    </main>

    <footer class="footer">

        © Vizi 2026 - Todos os direitos reservados.

        <div class="contato">

            <a>
                Contato
            </a>

            <a>
                vizi.site@gmail.com
            </a>

        </div>

    </footer>

</body>
</html>